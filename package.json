{
  "name": "@mogulmoretti/skrape",
  "version": "0.2.1",
  "description": "Read Skool course content instead of watching it — pulls the classroom of a community you belong to into clean, readable transcripts.",
  "keywords": [
    "skool",
    "cli",
    "transcript",
    "video-to-text",
    "loom",
    "course"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/slyngg/skrape.git"
  },
  "bugs": {
    "url": "https://github.com/slyngg/skrape/issues"
  },
  "homepage": "https://github.com/slyngg/skrape#readme",
  "type": "module",
  "bin": {
    "skrape": "dist/cli.js"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc && chmod +x dist/cli.js",
    "prepublishOnly": "npm run build && npm test",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "better-sqlite3": "^11.5.0",
    "commander": "^12.1.0",
    "ink": "^7.1.1",
    "react": "^19.2.8",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.11",
    "@types/node": "^22.9.0",
    "@types/react": "^19.2.18",
    "typescript": "^5.6.3",
    "vitest": "^2.1.4"
  },
  "optionalDependencies": {
    "playwright": "^1.48.2"
  }
}
